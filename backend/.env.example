# Wadih Backend Configuration
PROJECT_NAME="Wadih Genetic Risk Clarity Platform"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database Configuration
# Default to SQLite for effortless local dev/testing, or set PostgreSQL:
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/wadih_db"
DATABASE_URL="sqlite:///./wadih_dev.db"

# Security & Authentication
# Note: For production, generate a secure random secret using `openssl rand -hex 32`
SECRET_KEY="development_secret_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS Origins (comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173"
